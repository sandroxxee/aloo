{
  "entities": {
    "MessageTemplate": {
      "title": "MessageTemplate",
      "description": "Template for WhatsApp outreach messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Template name" },
        "category": { "type": "string", "description": "Template category (e.g. Price Inquiry, Vehicle Details, Follow-up)" },
        "text": { "type": "string", "description": "Message content" },
        "mediaUrl": { "type": "string", "description": "Optional media attachment URL" },
        "sendAsAudioTTS": { "type": "boolean", "description": "Whether to send as TTS audio" },
        "aiSuggested": { "type": "boolean", "description": "If the template was AI-generated" },
        "userId": { "type": "string", "description": "Owner of the template" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "text", "userId"]
    }
  },
  "firestore": {
    "templates": {
      "schema": "MessageTemplate",
      "description": "Collection of WhatsApp message templates"
    }
  }
}
