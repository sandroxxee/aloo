# MINERADOR PRO - Environment Configuration

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite://./data/minerador_pro.db

# For PostgreSQL (optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/minerador_pro

# ============================================
# AI PROVIDERS (Optional)
# ============================================

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alternative providers can be added here

# ============================================
# SEARCH ENGINES (Optional)
# ============================================

# Google Custom Search API
GOOGLE_API_KEY=
GOOGLE_CX=

# ============================================
# MESSAGING
# ============================================

# WhatsApp (Evolution API or similar)
WHATSAPP_INSTANCE_NAME=minerador_pro
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_URL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# ============================================
# SYSTEM
# ============================================
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ============================================
# MINING CONFIGURATION
# ============================================
MINING_CONCURRENCY=5
MINING_RATE_LIMIT_PER_MINUTE=30
ENABLE_VALIDATION=true
ENABLE_DEDUPLICATION=true
ENABLE_SCORING=true

# ============================================
# GEOGRAPHIC
# ============================================
INITIAL_LAT=-26.8747
INITIAL_LNG=-52.4089
INITIAL_RADIUS_KM=50
